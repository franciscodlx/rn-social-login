{
  "name": "@franciscodlxdev/rn-auth-core",
  "version": "0.1.1",
  "description": "OAuth 2.0 + PKCE in the system browser for React Native (ASWebAuthenticationSession / Custom Tabs). Shared core of the rn-social-login plugins.",
  "main": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "exports": {
    ".": {
      "rn-social-login-source": "./src/index.ts",
      "types": "./lib/typescript/src/index.d.ts",
      "default": "./lib/module/index.js"
    },
    "./app.plugin.js": "./app.plugin.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "*.podspec",
    "app.plugin.js",
    "plugin",
    "!ios/build",
    "!android/build",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "scripts": {
    "build": "bob build",
    "typecheck": "tsc",
    "test": "jest"
  },
  "keywords": [
    "react-native",
    "ios",
    "android",
    "oauth",
    "oauth2",
    "pkce",
    "oidc",
    "social-login",
    "turbo-module"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/franciscodlx/rn-social-login.git",
    "directory": "packages/auth-core"
  },
  "author": "Francisco (https://github.com/franciscodlx)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/franciscodlx/rn-social-login/issues"
  },
  "homepage": "https://github.com/franciscodlx/rn-social-login/tree/main/packages/auth-core#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "codegenConfig": {
    "name": "RnAuthCoreSpec",
    "type": "modules",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "com.franciscodlx.rnauthcore"
    }
  }
}
